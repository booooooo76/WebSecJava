### 1. CREATE with valid credentials - Happy Pass, expect 201
POST http://localhost:8081/api/notes
Authorization: Basic admin admin123
Content-Type: application/json
Accept: application/json

{
  "title": "Secured note",
  "content": "Created with Basic auth"
}

> {%
    client.test("CREATE returns 201", function () {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
    client.global.set("noteId", response.body.id);
%}

### 2. READ ALL with valid credentials - Happy Pass, expect 200
GET http://localhost:8081/api/notes
Authorization: Basic admin admin123
Accept: application/json

> {%
    client.test("READ ALL returns 200", function () {
